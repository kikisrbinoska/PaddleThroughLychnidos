    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaddleThroughLychnidos.Application\PaddleThroughLychnidos.Application.csproj" />
    <ProjectReference Include="..\PaddleThroughLychnidos.Infrastructure\PaddleThroughLychnidos.Infrastructure.csproj" />
  </ItemGroup>

