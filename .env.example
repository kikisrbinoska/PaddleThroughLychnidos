# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (db service) ---
POSTGRES_DB=PaddleThroughLychnidosDatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- API (api service) ---
# Host port the API is reachable on from your machine / the frontend build.
API_HTTP_PORT=8080

# Runs EF Core migrations automatically on API startup. Convenient for
# local dev; leave this OFF once this stack targets anything beyond a
# local machine (e.g. once Azure deployment is set up).
AUTO_MIGRATE=true

JWT_SECRET=change-this-to-a-long-random-string
JWT_ISSUER=PaddleThroughLychnidos
JWT_AUDIENCE=PaddleThroughLychnidos

YOUTUBE_API_KEY=

# --- Web (web service) ---
# Host port nginx is reachable on from your browser.
WEB_HTTP_PORT=80

# Origin the API's CORS policy allows - must match how you reach the web
# service from a browser.
FRONTEND_ORIGIN=http://localhost
