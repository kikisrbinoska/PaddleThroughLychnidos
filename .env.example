# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (db service) ---
POSTGRES_DB=PaddleThroughLychnidosDatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- API (api service) ---
# Host port the API is reachable on from your machine / the frontend build.
API_HTTP_PORT=8080

# Runs EF Core migrations automatically on API startup. Convenient for
# local dev; leave this OFF once this stack targets anything beyond a
# local machine (e.g. once Azure deployment is set up).
AUTO_MIGRATE=true

JWT_SECRET=change-this-to-a-long-random-string
JWT_ISSUER=PaddleThroughLychnidos
JWT_AUDIENCE=PaddleThroughLychnidos

YOUTUBE_API_KEY=

# --- Web (web service) ---
# Host port nginx is reachable on from your browser.
WEB_HTTP_PORT=80

# Origin(s) the API's CORS policy allows - comma-separated, must match how
# you reach the web service from a browser. To also test from a phone on
# the same WiFi network, add your machine's LAN IP, e.g.
# http://localhost,http://192.168.0.103 (find the IP with `ipconfig`, the
# Wi-Fi adapter's IPv4 Address).
FRONTEND_ORIGIN=http://localhost

# Base URL the frontend calls for API requests - baked into the frontend
# build at build time. Must match how the browser reaches the api service;
# switch to your machine's LAN IP alongside FRONTEND_ORIGIN above when
# testing from a phone, e.g. http://192.168.0.103:8081/api (LAN IP works
# for both this machine and other devices, so it can replace localhost
# entirely once set).
VITE_API_BASE_URL=http://localhost:8080/api
